{
  "name": "application-shell",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/feature/application-shell/src",
  "prefix": "sym",
  "projectType": "library",
  "tags": ["scope:frontend", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/frontend/feature/application-shell/ng-package.json",
        "tsConfig": "libs/frontend/feature/application-shell/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/frontend/feature/application-shell/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/frontend/feature/application-shell/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
