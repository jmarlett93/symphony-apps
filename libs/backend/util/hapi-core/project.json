{
  "name": "hapi-core",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/util/hapi-core/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build"],
      "options": {
        "main": "libs/backend/util/hapi-core/src/index.ts",
        "outputPath": "dist/libs/backend/util/hapi-core",
        "outputFileName": "index.js",
        "tsConfig": "libs/backend/util/hapi-core/tsconfig.lib.json",
        "platform": "node",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": false,
        "external": ["@hapi/boom", "@hapi/hapi", "zod"],
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/backend/util/hapi-core",
        "command": "vitest run"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/backend/util/hapi-core/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
