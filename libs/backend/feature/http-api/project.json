{
  "name": "http-api",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/feature/http-api/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build"],
      "options": {
        "platform": "node",
        "outputPath": "dist/libs/backend/feature/http-api",
        "outputFileName": "index.js",
        "format": ["cjs"],
        "bundle": true,
        "main": "libs/backend/feature/http-api/src/index.ts",
        "tsConfig": "libs/backend/feature/http-api/tsconfig.lib.json",
        "packageJson": "libs/backend/feature/http-api/package.json",
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          },
          "external": ["@hapi/hapi"]
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/backend/feature/http-api",
        "command": "vitest run --passWithNoTests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/backend/feature/http-api/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
